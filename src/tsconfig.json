{
  // Frontend TypeScript: src/ is compiled one file to one file into public/js/ by tools/build.sh. Browsers load the files as
  // ES modules (script type="module"); imports spell out .ts and are rewritten to .js on the way out.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "removeComments": true,
    "newLine": "lf",
    "skipLibCheck": true,
    "paths": {
      "/lib/maplibre-gl.js": ["../node_modules/maplibre-gl/dist/maplibre-gl.d.ts"],
      "/lib/pmtiles.js": ["../node_modules/pmtiles/dist/esm/index.d.ts"]
    },
    "rootDir": ".",
    "outDir": "../public/js"
  },
  "include": [".", "../vendor/frostline/components/index.d.ts"]
}
