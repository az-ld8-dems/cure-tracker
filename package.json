{
  "name": "cure-tracker",
  "private": true,
  "description": "Ballot cure tracker for LD8: assigns volunteers to voters whose ballots need curing. Internal tool; lives a couple of weeks.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tools/build.sh",
    "dev": "node tools/dev.ts",
    "typecheck": "wrangler types --config wrangler.jsonc --path worker/worker-configuration.d.ts && tsc -p worker && tsc -p vendor/frostline --noEmit && tsc -p src --noEmit && tsc -p tools",
    "test": "npm run test:access && npm run test:import && npm run test:format && npm run test:api && npm run test:people && npm run test:upload-sql && npm run test:migration-methods && npm run test:geocode && npm run test:near && npm run test:map && npm run test:organizers && npm run test:assign-email && npm run test:invites && npm run test:pin-contrast && npm run test:lighthouse",
    "test:access": "node tools/test-access.ts",
    "test:import": "node tools/test-import.ts",
    "test:api": "node tools/test-api.ts",
    "test:people": "node tools/test-people.ts",
    "test:migration-methods": "node tools/test-migration-methods.ts",
    "test:upload-sql": "node tools/test-upload-sql.ts",
    "test:geocode": "node tools/test-geocode.ts",
    "test:near": "node tools/test-near.ts",
    "test:map": "node tools/test-map.ts",
    "test:organizers": "node tools/test-organizers.ts",
    "test:assign-email": "node tools/test-assign-email.ts",
    "test:invites": "node tools/test-invites.ts",
    "test:pin-contrast": "node tools/test-pin-contrast.ts",
    "bench": "node tools/bench-scale.ts",
    "synthetic": "node tools/make-synthetic-sheet.ts",
    "test:lighthouse": "node tools/test-lighthouse-budgets.ts",
    "smoke": "node tools/smoke.ts",
    "lighthouse": "node tools/lighthouse.ts",
    "check": "biome ci --error-on-warnings",
    "lint": "biome lint",
    "format": "biome check --write --linter-enabled=false",
    "fix": "biome check --write",
    "deploy": "tools/build.sh && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply cure-tracker --remote",
    "db:migrate:local": "wrangler d1 migrations apply cure-tracker --local",
    "test:format": "node tools/test-format.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@protomaps/basemaps": "5.7.2",
    "@types/node": "24.19.2",
    "lighthouse": "13.5.0",
    "maplibre-gl": "6.16.0",
    "playwright": "1.64.0",
    "pmtiles": "4.5.0",
    "typescript": "7.0.2",
    "wrangler": "4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "fsevents": false
  }
}
